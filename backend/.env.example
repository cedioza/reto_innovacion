# Copia este archivo a .env y ajusta los valores según tu entorno.

# URL del frontend permitida por CORS
FRONTEND_URL=http://localhost:5173

# Gemini API — obtener en Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# WhatsApp Cloud API — Meta for Developers, app con número de prueba.
# WHATSAPP_TOKEN: token temporal/permanente de la app.
# WHATSAPP_PHONE_ID: id del número de prueba (phone_number_id).
# WHATSAPP_TEST_TO: número destino pre-registrado en el número de prueba,
#   formato E.164 sin "+" (ej: 573001234567).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEST_TO=

# Postgres de Railway — cadena de conexión del plugin Postgres del proyecto.
DATABASE_URL=

# Resend — obtener en resend.com.
# RESEND_API_KEY: API key de la cuenta.
# RESEND_TEST_TO: buzón destino de prueba para el health check.
RESEND_API_KEY=
RESEND_TEST_TO=

# Telegram Bot API — plan B de canal.
# TELEGRAM_BOT_TOKEN: token del bot creado con @BotFather.
# TELEGRAM_TEST_CHAT_ID: chat destino de prueba; se obtiene escribiéndole al
#   bot y consultando https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
