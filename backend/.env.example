# Copia este archivo a .env y ajusta los valores según tu entorno.

# URL del frontend permitida por CORS
FRONTEND_URL=http://localhost:5173

# URL pública HTTPS del backend desplegado (p. ej. el dominio asignado en
# Dokploy); requerida solo para registrar el webhook de Telegram.
BACKEND_PUBLIC_URL=

# Gemini API — obtener en Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# WhatsApp Cloud API — Meta for Developers, app con número de prueba.
# WHATSAPP_TOKEN: token temporal/permanente de la app.
# WHATSAPP_PHONE_ID: id del número de prueba (phone_number_id).
# WHATSAPP_TEST_TO: número destino pre-registrado en el número de prueba,
#   formato E.164 sin "+" (ej: 573001234567).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEST_TO=

# Postgres — cadena de conexión del servicio de BD creado en Dokploy.
# Si se deja vacía, el backend cae a SQLite local (backend/app/data/local.db,
# solo para desarrollo, sin Alembic: las tablas se crean automáticamente).
# Valor recomendado en local (docker compose up -d db):
# postgresql://reto:reto@localhost:5432/reto_innovacion
DATABASE_URL=

# Resend — obtener en resend.com.
# RESEND_API_KEY: API key de la cuenta.
# RESEND_TEST_TO: buzón destino de prueba para el health check.
RESEND_API_KEY=
RESEND_TEST_TO=

# Telegram Bot API — plan B de canal.
# TELEGRAM_BOT_TOKEN: token del bot creado con @BotFather.
# TELEGRAM_TEST_CHAT_ID: chat destino de prueba; se obtiene escribiéndole al
#   bot y consultando https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=

# Webhooks
# WHATSAPP_VERIFY_TOKEN: token que Meta debe enviar para verificar el webhook.
# Genera tu propio valor aleatorio; sin este valor, la verificación del
# webhook responde 403.
WHATSAPP_VERIFY_TOKEN=

# TELEGRAM_WEBHOOK_SECRET: token secreto que Telegram enviará en el header
# X-Telegram-Bot-Api-Secret-Token para verificar que la llamada viene de Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Provider: ycloud (default) or meta. To switch back to Meta, set WHATSAPP_PROVIDER=meta.
WHATSAPP_PROVIDER=ycloud
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=
# YCloud-Signature secret. Required in production.
YCLOUD_WEBHOOK_SECRET=
# Set true only for local development without YCloud signatures. Keep false in production.
YCLOUD_ALLOW_UNSIGNED_WEBHOOKS=false
# Maximum allowed age (or clock skew) for signed webhook timestamps.
YCLOUD_WEBHOOK_TOLERANCE_SECONDS=300

# Ruta al CSV anonimizado de afiliados. Si se deja vacío se usa el default
# backend/app/data/afiliados.csv.
AFFILIATE_CSV_PATH=

# Ruta al catálogo de productos en JSON. Si se deja vacío se usa el default
# backend/app/data/catalogo/productos.json (JSON del repo).
CATALOG_JSON_PATH=
